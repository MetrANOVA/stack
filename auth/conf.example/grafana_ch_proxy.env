PROXY_MODE=local

# Target ClickHouse instance (local, self-signed TLS)
CLICKHOUSE_URL=https://clickhouse:8443
PROXY_VERIFY_TLS=false

# LDAP — used to look up the logged-in Grafana user's current nonce (employeeNumber)
# so their ClickHouse identity is passed through directly.
# LDAP_BIND_PASSWORD is synced from openldap.env by make docker.
LDAP_HOST=openldap
LDAP_PORT=389
LDAP_BASE_DN=dc=metranova,dc=io
LDAP_BIND_DN=cn=admin,dc=metranova,dc=io
LDAP_BIND_PASSWORD=CHANGEME

# Fallback service account for health checks and users not yet in LDAP.
# CH_GRAFANA_USER and CH_GRAFANA_PASSWORD are sourced from
# ../clickhouse/conf/clickhouse.env (generated by clickhouse-init).
