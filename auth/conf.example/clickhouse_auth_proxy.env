# LDAP connection — reads credentials stored by the token-store
# LDAP_BIND_PASSWORD is synced from openldap.env by make docker
LDAP_HOST=openldap
LDAP_PORT=389
LDAP_BASE_DN=dc=metranova,dc=io
LDAP_BIND_DN=cn=admin,dc=metranova,dc=io
LDAP_BIND_PASSWORD=CHANGEME

# Encryption key — must match token-store so the proxy can decrypt stored credentials
# Auto-synced from token_store.env by make docker
TOKEN_STORE_ENCRYPTION_KEY=CHANGEME

# OIDC client used for ROPC token exchange with remote instances
# Must match a public (no-secret) client on the remote Keycloak realm
OIDC_CLIENT_ID=cross-instance
