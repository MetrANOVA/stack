# Fernet symmetric encryption key — auto-generated by make docker
TOKEN_STORE_ENCRYPTION_KEY=CHANGEME

# LDAP connection — LDAP_BIND_PASSWORD is synced from openldap.env by make docker
LDAP_HOST=openldap
LDAP_PORT=389
LDAP_BASE_DN=dc=metranova,dc=io
LDAP_BIND_DN=cn=admin,dc=metranova,dc=io
LDAP_BIND_PASSWORD=CHANGEME
