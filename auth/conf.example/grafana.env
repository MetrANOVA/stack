# OAuth client secret for Grafana's Keycloak client — auto-generated by make docker
GRAFANA_CLIENT_SECRET=CHANGEME

# Grafana admin UI password — auto-generated by make docker (save this!)
GF_SECURITY_ADMIN_PASSWORD=CHANGEME
GF_SECURITY_ADMIN_USER=admin

# Plugin installed on first startup (requires internet access)
GF_INSTALL_PLUGINS=grafana-clickhouse-datasource
