# Public hostname for this MetrANOVA instance.
# Used for OAuth2 redirect URIs, OIDC issuer URLs, and TLS cert SAN.
# Set to 'localhost' for local development, or your FQDN for production.
AUTH_DOMAIN=localhost

# Keycloak realm name. Must match the realm in metranova-realm.json.
AUTH_REALM=metranova
