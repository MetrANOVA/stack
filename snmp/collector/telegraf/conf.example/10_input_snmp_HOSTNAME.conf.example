[[inputs.snmp]]
# List of hosts to poll
## One [[inputs.snmp]] block per host is recommended for independent polling goroutines.
## Generally the easiest way to do this is to make a copy of this file for each host you want to poll
agents = [
"udp://HOSTNAME:161"
]

## SNMP community string.
community = "COMMUNITY_STRING"

## Tag to use for the source host address
agent_host_tag = "source"

## Polling interval
interval = "60s"

## Timeout for each request.
timeout = "10s"

## SNMP version; can be 1, 2, or 3.
version = 2

## Number of retries to attempt.
retries = 2

## SNMP max max repetitions (i.e. max results SNMP returns in response)
max_repetitions = 20

[inputs.snmp.tags]
type = "snmp"
# Set this to match your polling interval (in seconds)
interval = "60"

##############
# MIBs to poll

## IF-MIB
[[inputs.snmp.table]]
name = "snmp_if"
index_as_tag = true

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.31.1.1.1.18"
name = "SNMP_IF-MIB::ifAlias"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.31.1.1.1.1"
name = "SNMP_IF-MIB::ifName"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.31.1.1.1.15"
name = "SNMP_IF-MIB::ifHighSpeed"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.2.2.1.5"
name = "SNMP_IF-MIB::ifSpeed"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.2.2.1.7"
name = "SNMP_IF-MIB::ifAdminStatus"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.2.2.1.8"
name = "SNMP_IF-MIB::ifOperStatus"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.31.1.1.1.6"
name = "SNMP_IF-MIB::ifHCInOctets"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.31.1.1.1.10"
name = "SNMP_IF-MIB::ifHCOutOctets"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.31.1.1.1.9"
name = "SNMP_IF-MIB::ifHCInBroadcastPkts"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.31.1.1.1.12"
name = "SNMP_IF-MIB::ifHCOutMulticastPkts"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.31.1.1.1.8"
name = "SNMP_IF-MIB::ifHCInMulticastPkts"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.31.1.1.1.13"
name = "SNMP_IF-MIB::ifHCOutBroadcastPkts"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.31.1.1.1.7"
name = "SNMP_IF-MIB::ifHCInUcastPkts"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.31.1.1.1.11"
name = "SNMP_IF-MIB::ifHCOutUcastPkts"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.2.2.1.20"
name = "SNMP_IF-MIB::ifOutErrors"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.2.2.1.19"
name = "SNMP_IF-MIB::ifOutDiscards"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.2.2.1.14"
name = "SNMP_IF-MIB::ifInErrors"

[[inputs.snmp.table.field]]
oid = "1.3.6.1.2.1.2.2.1.13"
name = "SNMP_IF-MIB::ifInDiscards"
