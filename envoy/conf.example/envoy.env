# TLS settings for the Envoy listener certificate
ENVOY_TLS_DNS_NAME=localhost
ENVOY_TLS_KEY_ALG=RSA
ENVOY_TLS_KEY_SIZE=2048
ENVOY_TLS_UID=101
ENVOY_TLS_GID=101

# HTTPS listener address (use :: for IPv6-only environments)
# ENVOY_LISTEN_ADDRESS=::
ENVOY_LISTEN_ADDRESS=0.0.0.0

# HTTPS listener port (external)
ENVOY_HTTPS_PORT=443

# Set to true to listen on port 80 and redirect all traffic to HTTPS
ENVOY_HTTP_REDIRECT=true
ENVOY_HTTP_PORT=80

# Set to true to enable Envoy's simple HTTP cache for /public-dashboards/* requests.
# Cache TTL (seconds) is controlled by ENVOY_GRAFANA_CACHE_TTL.
# Has no effect when ENVOY_UPSTREAM_GRAFANA is false.
ENVOY_GRAFANA_CACHE_PUBLIC_DASHBOARDS=false
ENVOY_GRAFANA_CACHE_TTL=60
