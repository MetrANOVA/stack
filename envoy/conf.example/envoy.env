# TLS settings for the Envoy listener certificate
ENVOY_TLS_DNS_NAME=localhost
ENVOY_TLS_KEY_ALG=RSA
ENVOY_TLS_KEY_SIZE=2048
ENVOY_TLS_UID=101
ENVOY_TLS_GID=101

# HTTPS listener address (use :: for IPv6-only environments)
# ENVOY_LISTEN_ADDRESS=::
ENVOY_LISTEN_ADDRESS=0.0.0.0

# HTTPS listener port (external)
ENVOY_HTTPS_PORT=443
