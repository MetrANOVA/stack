static_resources:

  listeners:
    - name: https_listener
      address:
        socket_address:
          address: {{ listen_address }}
          port_value: {{ https_port }}
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: ingress_https
                route_config:
                  name: local_route
                  virtual_hosts:
                    - name: backends
                      domains: ["*"]
                      routes:
{% if clickhouse %}
                        - match:
                            prefix: "/clickhouse"
                          route:
                            cluster: clickhouse
                            prefix_rewrite: "/"
                            timeout: 300s
{% endif %}
{% if grafana %}
                        - match:
                            prefix: "/"
                          route:
                            cluster: grafana
                            timeout: 60s
{% endif %}
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                tls_certificates:
                  - certificate_chain:
                      filename: /srv/envoy/certs/server.crt
                    private_key:
                      filename: /srv/envoy/certs/server.key

  clusters:
{% if grafana %}
    - name: grafana
      connect_timeout: 5s
      type: STRICT_DNS
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: grafana
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: grafana
                      port_value: 3000
{% endif %}
{% if clickhouse %}
    - name: clickhouse
      connect_timeout: 5s
      type: STRICT_DNS
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: clickhouse
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: clickhouse
                      port_value: 8443
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /srv/clickhouse/ca.crt
{% endif %}
