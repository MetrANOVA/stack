# Users and database
CH_DEFAULT_USER=default
CH_DEFAULT_PASSWORD=default-secret
CH_PIPELINE_USER=pipeline
CH_PIPELINE_PASSWORD=pipeline-secret
CH_GRAFANA_USER=grafana
CH_GRAFANA_PASSWORD=grafana-secret
## Database on which pipeline user has permissions
CH_DATABASE=metranova

# TLS defaults
CH_TLS_DNS_NAME=clickhouse
CH_TLS_KEY_ALG=RSA
CH_TLS_KEY_SIZE=2048
CH_TLS_UID=101
CH_TLS_GID=101

# Ports (set HTTP/TCP to empty to disable non-TLS by default)
CH_HTTP_PORT=
CH_HTTPS_PORT=8443
CH_TCP_PORT=
CH_TCP_SECURE_PORT=9440

# Listen hosts (allow other containers to connect)
# If your Docker environment does not support IPv6 (common on macOS), use:
# CH_LISTEN_HOSTS=0.0.0.0
# If your host is IPv6-only, use:
# CH_LISTEN_HOSTS=::
CH_LISTEN_HOSTS=0.0.0.0

# Init DB settings
INITDB_HOST=clickhouse
INITDB_WAIT_SECONDS=120
INITDB_WAIT_INTERVAL_SECONDS=3
INITDB_USERS_FILE=/etc/clickhouse-server/users.d/users.xml
