              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "flow_count"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "metranova-clickhouse"
          },
          "rawSql": "SELECT\n  if(ip_version = 6, 'IPv6', 'IPv4') AS version,\n  count() AS flow_count,\n  sum(bit_count) AS total_bits\nFROM metranova.data_flow\nWHERE $__timeFilter(insert_time)\nGROUP BY version\nORDER BY version",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ],
