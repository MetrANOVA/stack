# Default values for metranova-flow-pipeline

# Global settings
global:
  imagePullSecrets: []
  storageClassName: ""

# Image settings
image:
  repository: ghcr.io/metranova/pipeline
  pullPolicy: IfNotPresent
  tag: "latest"

# Data Flow service configuration
dataFlow:
  enabled: true
  replicaCount: 1
  resources:
    limits:
      cpu: 1000m
      memory: 8Gi
    requests:
      cpu: 250m
      memory: 512Mi
  env:
    pipelineYaml: /app/pipelines/data_flow.yml
    kafkaTopic: metranova_flow
    clickhouseFlowTable: data_flow
    clickhouseFlowTtl: "30 DAY"
    clickhouseFlowTtlColumn: "start_time"
    clickhouseCacherTables: "meta_as,meta_device:@loopback_ip,meta_interface:device_id:flow_index:edge"
    clickhouseRangedCacherConfigs: "meta_application:meta_application_dict:port_range_min:port_range_max:protocol:id"
    clickhouseCacherRefreshInterval: "3600"
    clickhouseFlowPolicyCommunityScope: "64805:lhcone,64806:lsst,64807:fabric,293:ipt"
    clickhouseFlowPolicyAutoScopes: "true"
    clickhouseFlowExtensions: "bgp,ipv4,ipv6,mpls"
    clickhouseFlowIpRefExtensions: "scireg"
    # Leave empty to use the chart-computed default service URL.
    ipCacherBaseUrl: ""
    # Policy Settings
    clickhousePolicyOriginator: "unknown"
    clickhousePolicyLevel: "tlp:amber"
    clickhousePolicyScope: ""
    # Materialized View Configuration
    # Comma-separated list of aggregation windows (e.g., "5m,1h,1d,1w")
    # Leave empty to disable that materialized view type
    clickhouseFlowMvByEdgeAs: ""
    clickhouseFlowMvByInterface: ""
    clickhouseFlowMvByIpVersion: ""
    ipCacherTables: "meta_ip_scireg,meta_ip"
  # Optional per-window materialized view settings
  # Format: mvSettings.<type>.<window>.<setting>
  # Types: edgeAs, interface, ipVersion
  # Windows: 5m, 1h, 1d, 1w, 1mo, 1y (lowercase)
  # Settings: table, ttl, ttlColumn, partitionBy, policyLevel, policyScope, policyOverride
  mvSettings: {}
    # Example:
    # edgeAs:
    #   5m:
    #     ttl: "90 DAY"
    #     policyLevel: "tlp:amber"
    #   1h:
    #     table: "custom_edge_as_1h"
    # interface:
    #   1d:
    #     partitionBy: "toYYYYMM(start_time)"


# Metadata CAIDA Org AS service configuration
metadataCaidaOrgAs:
  enabled: true
  replicaCount: 1
  resources:
    limits:
      cpu: 500m
      memory: 1Gi
    requests:
      cpu: 250m
      memory: 256Mi
  env:
    pipelineYaml: /app/pipelines/metadata_caida_org_as.yml
    clickhouseAsMetadataExtensions: peeringdb
    clickhouseMetadataForceUpdate: "false"
    caidaOrgAsConsumerAs2orgFile: /app/caches/caida_as_org2info.jsonl
    caidaOrgAsConsumerPeeringdbFile: /app/caches/caida_peeringdb.json
    caidaOrgAsConsumerCustomAsFile: /app/caches/custom_as_additions.yml
    caidaOrgAsConsumerCustomOrgFile: /app/caches/custom_org_additions.yml
    caidaOrgAsConsumerUpdateInterval: "86400"
    # AS Dictionary Settings
    clickhouseAsDictionaryEnabled: "true"
    clickhouseAsDictionaryName: "meta_as_dict"
    clickhouseAsDictionaryLifetimeMin: "600"
    clickhouseAsDictionaryLifetimeMax: "3600"

# Metadata File Export service configuration
metadataFileExport:
  enabled: true
  replicaCount: 1
  resources:
    limits:
      cpu: 500m
      memory: 512Mi
    requests:
      cpu: 250m
      memory: 256Mi
  env:
    pipelineYaml: /app/pipelines/metadata_file_export.yml
    clickhouseMetadataForceUpdate: "false"
    clickhouseIfMetadataExtensions: "sap,vrtr,vrtr_interface"
    clickhouseAsMetadataExtensions: "peeringdb"
    fileConsumerPaths: /app/conf/meta_interface.yml,/app/conf/meta_device.yml,/app/conf/meta_circuit.yml,/app/conf/meta_application.yml
    fileConsumerUpdateInterval: "600"
    # Application Dictionary Settings
    clickhouseApplicationDictionaryEnabled: "true"
    clickhouseApplicationDictionaryName: "meta_application_dict"
    clickhouseApplicationDictionaryLifetimeMin: "600"
    clickhouseApplicationDictionaryLifetimeMax: "3600"
    # AS Dictionary Settings
    clickhouseAsDictionaryEnabled: "true"
    clickhouseAsDictionaryName: "meta_as_dict"
    clickhouseAsDictionaryLifetimeMin: "600"
    clickhouseAsDictionaryLifetimeMax: "3600"

# Metadata IP Geo service configuration
metadataIpGeo:
  enabled: true
  replicaCount: 1
  resources:
    limits:
      cpu: 500m
      memory: 8Gi
    requests:
      cpu: 250m
      memory: 512Mi
  env:
    pipelineYaml: /app/pipelines/metadata_ip_geo.yml
    clickhouseMetadataForceUpdate: "false"
    #IP_GEO_CSV_CONSUMER_USE_MAXMIND_DOWNLOAD
    ipGeoCsvConsumerUseMaxMindDownload: "true"
    ipGeoCsvConsumerMaxMindAccountId: ""
    ipGeoCsvConsumerMaxMindLicenseKey: ""
    ipGeoCsvConsumerAsnFiles: /app/caches/GeoLite2-ASN-Blocks-IPv4.csv,/app/caches/GeoLite2-ASN-Blocks-IPv6.csv
    ipGeoCsvConsumerLocationFiles: /app/caches/GeoLite2-City-Locations-en.csv
    ipGeoCsvConsumerIpBlockFiles: /app/caches/GeoLite2-City-Blocks-IPv4.csv,/app/caches/GeoLite2-City-Blocks-IPv6.csv
    ipGeoCsvConsumerCustomIpFile: /app/caches/custom_ip_additions.yml
    ipGeoCsvConsumerUpdateInterval: "86400"

# Metadata SciReg service configuration
metadataScireg:
  enabled: true
  replicaCount: 1
  resources:
    limits:
      cpu: 500m
      memory: 512Mi
    requests:
      cpu: 250m
      memory: 256Mi
  env:
    pipelineYaml: /app/pipelines/metadata_scireg.yml
    clickhouseMetadataForceUpdate: "false"
    httpConsumerEnvPrefix: SCIREG
    sciregHttpConsumerUpdateInterval: "3600"
    sciregHttpConsumerUrls: "https://downloads.netsage.io/scireg.json"

# Metadata CRIC service configuration (LHC-specific)
metadataCric:
  enabled: false
  replicaCount: 1
  resources:
    limits:
      cpu: 500m
      memory: 512Mi
    requests:
      cpu: 250m
      memory: 256Mi
  env:
    pipelineYaml: /app/pipelines/metadata_cric.yml
    clickhouseMetadataForceUpdate: "false"
    httpConsumerEnvPrefix: CRIC_IP
    cricIpHttpConsumerUrls: "https://wlcg-cric.cern.ch/api/core/rcsite/query/list/?json"
    cricIpHttpConsumerUpdateInterval: "3600"
    cricUrlMatchPattern: "cric.cern.ch"

# Cache IP Trie service configuration
cacheIpTrie:
  enabled: true
  replicaCount: 1
  resources:
    limits:
      cpu: 500m
      memory: 8Gi
    requests:
      cpu: 250m
      memory: 256Mi
  env:
    pipelineYaml: /app/pipelines/cache_ip_trie.yml
    clickhouseConsumerTables: "meta_ip_scireg,meta_ip:as_id"
    clickhouseConsumerUpdateInterval: "3600"
    pickleFileDirectory: /app/caches

# Base configuration (shared across all services)
config:
  debug: "false"
  
  # Kafka configuration
  kafka:
    bootstrapServers: kafka:9092
    consumerGroup: metranova_pipeline
    ssl:
      enabled: true
      caLocation: /app/conf/certificates/kafka_ca.crt
      certificateLocation: /app/conf/certificates/kafka_user.crt
      keyLocation: /app/conf/certificates/kafka_user.key
      keyPassword: "CHANGEME"
  
  # ClickHouse configuration
  clickhouse:
    host: clickhouse
    port: 9440
    database: metranova
    username: pipeline_user
    password: "CHANGEME"
    batchSize: "10000"
    batchTimeout: "5"
    # clusterName: ""
    # replication: "false"
    # replicaPath: "/clickhouse/tables/{shard}/{database}/{table}"
    # replicaName: "{replica}"
    
    # Metadata tables
    tables:
      scireg: meta_ip_scireg
      interface: meta_interface
      device: meta_device
      organization: meta_organization
      circuit: meta_circuit
      as: meta_as
      ip: meta_ip

# Certificates
certificates:
  # Reference to existing secret containing Kafka TLS certificates
  # Default: "pipeline-user" which contains ca.crt, user.crt, and user.key
  existingSecret: "pipeline-user"
  # Mapping of certificate file names in the secret to expected mount names
  kafkaCASubPath: "ca.crt"
  kafkaCertSubPath: "user.crt"
  kafkaKeySubPath: "user.key"
  # If existingSecret is not provided, certificates can be created from files below
  kafka:
    ca: ""
    cert: ""
    key: ""

# Cache files configuration
caches:
  # Existing PVC for cache files
  existingPvc: ""
  # If existingPvc is not provided, a new PVC will be created
  storageSize: 5Gi
  storageClassName: ""

# Configuration files
configFiles:
  # Existing ConfigMap for configuration files
  existingConfigMap: ""
  # If existingConfigMap is not provided, files will be mounted from local conf/ directory
  metaInterface: ""
  metaDevice: ""
  metaCircuit: ""
  metaApplication: ""
  caidaAsOrg2Info: ""
  caidaPeeringDb: ""
  caidaCustomOrgAdditions: ""
  caidaCustomAsAdditions: ""
  ipgeoCustomIpFile: ""

# Service account
serviceAccount:
  create: true
  annotations: {}
  name: ""

# Pod annotations
podAnnotations: {}

# Pod security context
podSecurityContext: {}
  # fsGroup: 2000

# Security context
securityContext: {}
  # capabilities:
  #   drop:
  #   - ALL
  # readOnlyRootFilesystem: true
  # runAsNonRoot: true
  # runAsUser: 1000

# Node selector
nodeSelector: {}

# Tolerations
tolerations: []

# Affinity
affinity: {}
